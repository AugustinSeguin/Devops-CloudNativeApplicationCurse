{
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky install",
    "lint:front": "cd frontend && npm run lint",
    "lint:back": "cd backend && npm run lint",
    "lint:all": "npm run lint:front && npm run lint:back",
    "test:front": "cd frontend && npm run test",
    "test:back": "cd backend && npm run test",
    "test:all": "npm run test:front && npm run test:back",
    "build:front": "cd frontend && npm run build",
    "build:back": "cd backend && npm run build",
    "build:all": "npm run build:front && npm run build:back"
  }
}